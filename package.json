{
  "name": "tree-chat",
  "version": "1.2.1",
  "description": "DSH conversation branches and context editing",
  "type": "module",
  "license": "MIT",
  "icon": "assets/tree.svg",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "conversation-tree",
    "branching",
    "context"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check:host": "node scripts/check-host.mjs",
    "pack:plugin": "node scripts/build.mjs && node scripts/verify-package.mjs",
    "install:dsh": "node scripts/install.mjs",
    "uninstall:dsh": "node scripts/install.mjs --uninstall"
  },
  "author": "Snoyi Selew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevourerM/tree-chat.git"
  },
  "homepage": "https://github.com/DevourerM/tree-chat#readme",
  "bugs": {
    "url": "https://github.com/DevourerM/tree-chat/issues"
  }
}
